{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run site with Xdebug (needs PHP Debug extension + Xdebug)",
            "type": "php",
            "request": "launch",
            "runtimeArgs": ["-S", "localhost:8000", "router.php"],
            "program": "",
            "cwd": "${workspaceRoot}",
            "port": 9003,
            "serverReadyAction": {
                "pattern": "Development Server \\(http://localhost:([0-9]+)\\) started",
                "uriFormat": "http://localhost:%s/public/",
                "action": "openExternally"
            }
        },
        {
            "name": "Listen for Xdebug",
            "type": "php",
            "request": "launch",
            "port": 9003
        }
    ]
}
