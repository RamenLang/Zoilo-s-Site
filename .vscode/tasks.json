{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "1. Install database",
            "type": "shell",
            "command": "php scripts/install.php",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared" }
        },
        {
            "label": "2. Start server (http://localhost:8000)",
            "type": "shell",
            "command": "php -S localhost:8000 router.php",
            "isBackground": true,
            "problemMatcher": {
                "pattern": { "regexp": "^$" },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^PHP .* Development Server",
                    "endsPattern": "Development Server .* started"
                }
            },
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "group": { "kind": "build", "isDefault": true }
        },
        {
            "label": "Open in browser",
            "type": "shell",
            "command": "echo Open http://localhost:8000/public/ in your browser",
            "problemMatcher": []
        }
    ]
}
